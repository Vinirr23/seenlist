{
  "cli": {
    "version": ">= 20.5.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    },
    "preview-ios": {
      "distribution": "store",
      "channel": "preview",
      "autoIncrement": true,
      "ios": {}
    }
  },
  "submit": {
    "production": {},
    "preview-ios": {}
  }
}
